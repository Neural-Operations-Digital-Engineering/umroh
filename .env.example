# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase wajib diisi untuk production dan untuk semua operasi CMS.

# Hero video URL (self-hosted, <= 3MB, H.264/WebM 720p tanpa audio)
# Tanpa variabel ini, fallback ke company.media.heroVideoUrl di CMS.
# PENTING: Jangan hotlink aset pihak ketiga (S3 bucket lain) di production.
# Compress: ffmpeg -i input.mp4 -vf scale=1280:720 -c:v libx264 -crf 28 -an -movflags +faststart hero.mp4
NEXT_PUBLIC_HERO_VIDEO_URL=
